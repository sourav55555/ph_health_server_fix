{
  "compilerOptions": {
    /* =========================
       File Layout
    ========================== */
    "rootDir": "./src",
    "outDir": "./dist",

    /* =========================
       Environment Settings
    ========================== */
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],

    /* =========================
       Output
    ========================== */
    "sourceMap": true,

    /* =========================
       Strict Type Checking
    ========================== */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* =========================
       Interop
    ========================== */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/generated"
  ]
}